<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup / device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="backup_state.xml"/>
        <exclude domain="sharedpref" path="limit_alert_state.xml"/>
        <exclude domain="sharedpref" path="payment_pairing.xml"/>
        <exclude domain="sharedpref" path="payment_capture.xml"/>
        <exclude domain="file" path="capture_log.txt"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="backup_state.xml"/>
        <exclude domain="sharedpref" path="limit_alert_state.xml"/>
        <exclude domain="sharedpref" path="payment_pairing.xml"/>
        <exclude domain="sharedpref" path="payment_capture.xml"/>
        <exclude domain="file" path="capture_log.txt"/>
    </device-transfer>
</data-extraction-rules>
