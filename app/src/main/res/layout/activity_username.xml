<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAEA">

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/centerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="120dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Person icon - outline style, dark green, large -->
        <ImageView
            android:id="@+id/imgPerson"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_person"
            android:layout_marginBottom="48dp"/>

        <!-- Title - bold, large, centered -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Let's personalize your profile"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="48dp"/>

        <!-- Username input - ONLY underline, centered text, green cursor -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="UserName"
            android:textSize="20sp"
            android:textColor="#111111"
            android:textColorHint="#AAAAAA"
            android:gravity="center"
            android:background="@drawable/bg_input_underline"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:inputType="textPersonName"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Go ahead button - fixed at bottom -->
    <Button
        android:id="@+id/btnGoAhead"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Go ahead"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.02"
        android:background="@drawable/bg_button_green"
        android:stateListAnimator="@null"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"/>

</RelativeLayout>
