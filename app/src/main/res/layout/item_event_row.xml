<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_normal_row"
    android:layout_marginBottom="8dp"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowMain"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

<!-- 6-dot drag handle -->
    <ImageView
        android:id="@+id/imgDrag"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_drag"
        android:layout_marginEnd="10dp"/>

    <!-- Colored rounded square icon -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/imgEvent"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"/>
    </FrameLayout>

    <!-- Event name -->
    <TextView
        android:id="@+id/tvEventName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="#111111"/>

    <!-- Minus (archive) -->
    <ImageView
        android:id="@+id/btnMinus"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_minus"
        android:padding="4dp"
        android:layout_marginEnd="6dp"/>

    <!-- Pencil (rename) -->
    <ImageView
        android:id="@+id/btnEdit"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_edit"
        android:padding="4dp"
        android:layout_marginEnd="6dp"/>

    <!-- Trash (delete) -->
    <ImageView
        android:id="@+id/btnDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_delete"
        android:padding="4dp"/>
        </LinearLayout>

        <!-- Expanded limit info (filled in code) -->
        <LinearLayout
            android:id="@+id/limitPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"/>
    </LinearLayout>

    <!-- Thin limit bar along the bottom edge (filled in code) -->
    <FrameLayout
        android:id="@+id/limitBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="5dp"
        android:visibility="gone"/>
</FrameLayout>
